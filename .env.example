# VETTRI TN AI OS — Environment Configuration
# System: Government of Tamil Nadu Enterprise AI Platform

ENVIRONMENT=development
PROJECT_NAME="VETTRI TN AI OS"
API_V1_STR="/api/v1"
SECRET_KEY="vettri-super-secret-production-grade-key-tamil-nadu-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vettri_db
POSTGRES_USER=vettri_admin
POSTGRES_PASSWORD=VettriSecurePass2026
DATABASE_URL=postgresql+asyncpg://vettri_admin:VettriSecurePass2026@localhost:5432/vettri_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vettri_minio_admin
MINIO_SECRET_KEY=MinioSecurePass2026
MINIO_BUCKET_NAME=vettri-government-orders
MINIO_SECURE=false

# LLM Providers (Air-Gapped Sovereign Fallback + Cloud Tier)
PRIMARY_LLM_PROVIDER=gemini # options: gemini, claude, openai, ollama
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.3:70b"

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
